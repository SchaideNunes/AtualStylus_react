# Configuração do Servidor / API
PORT=3001
NODE_ENV=development

# Configuração do Banco de Dados SQL (MySQL / MariaDB da Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_hostinger
DB_PASSWORD=sua_senha_segura
DB_NAME=seu_banco_atualestilo

# Segredo de Autenticação JWT do Painel Administrativo
JWT_SECRET=super_segredo_jwt_trocar_em_producao_123456789
JWT_EXPIRES_IN=7d

# URL do Frontend React (para CORS)
CLIENT_URL=http://localhost:5173
