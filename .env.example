# ==============================================================================
# TEMPLATE DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais da Hostinger
# ==============================================================================

PORT=3001
NODE_ENV=production

# Configuração do Banco de Dados SQL na Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_atualestilo
DB_PASSWORD=sua_senha_segura_da_hostinger
DB_NAME=u123456789_atualestilo

# Segredo de Autenticação JWT do Painel Administrativo
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# URL do Frontend
CLIENT_URL=http://localhost:5173
